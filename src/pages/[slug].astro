---
import { Image, getImage } from "astro:assets";
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../layouts/Base.astro";

export async function getStaticPaths() {
    const panoramas = (await getCollection("panoramas")).sort(
        (a, b) => a.data.date.getTime() - b.data.date.getTime()
    );

    return panoramas.map((panorama, i) => ({
        params: { slug: panorama.id },
        props: {
            panorama,
            prev: panoramas[i - 1] ?? null,
            next: panoramas[i + 1] ?? null,
            index: i + 1,
            total: panoramas.length,
        },
    }));
}

interface Props {
    panorama: CollectionEntry<"panoramas">;
    prev: CollectionEntry<"panoramas"> | null;
    next: CollectionEntry<"panoramas"> | null;
    index: number;
    total: number;
}

const { panorama, prev, next, index, total } = Astro.props;
const { data } = panorama;
const { Content } = await render(panorama);
const ratio = data.image.width / data.image.height;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const home = base || "/";
const urlFor = (entry: CollectionEntry<"panoramas">) => `${base}/${entry.id}.html`;

const monthYear = data.date.toLocaleDateString("en-US", {
    month: "long",
    year: "numeric",
});

const fmtLat = (v: number) => `${Math.abs(v).toFixed(4)}° ${v >= 0 ? "N" : "S"}`;
const fmtLon = (v: number) => `${Math.abs(v).toFixed(4)}° ${v >= 0 ? "E" : "W"}`;
const mapUrl = `${base}/map#${panorama.id}`;
const fullImageUrl = data.full ? `${base}${data.full.src}` : null;
const indexStr = String(index).padStart(2, "0");
const totalStr = String(total).padStart(2, "0");

const fullImage = await getImage({
    src: data.image,
    width: Math.min(data.image.width, 2400),
    format: "webp",
});

const lqip = await getImage({
    src: data.image,
    width: 24,
    format: "jpg",
    quality: 30,
});
---

<Base title={data.title} description={`${data.title} — ${data.country}, ${monthYear}.`}>
    <main class="post post--logbook">
        <div class="post__topline shell-wide">
            <a class="post__back" href={home}><span data-language-value data-pt="← diário" data-en="← logbook">← diário</span></a>
            <span aria-label={`Entry ${index} of ${total}`}><span data-language-value data-pt="entrada" data-en="entry">entrada</span> {indexStr} / {totalStr}</span>
            <time datetime={data.date.toISOString()}>{monthYear}</time>
        </div>

        <header class="post__entry-heading shell-wide">
            <h1 class="post__title" data-language-value data-pt={data.title} data-en={data.titleEn ?? data.title}>{data.title}</h1>
        </header>

        <div class="post__spread shell-wide">
            <div class="post__media" data-gallery>
                <a
                    class="post__frame"
                    href={fullImage.src}
                    data-pswp-width={fullImage.attributes.width ?? data.image.width}
                    data-pswp-height={fullImage.attributes.height ?? data.image.height}
                    data-pswp-src={fullImage.src}
                    style={`--frame-width: ${(ratio * 70).toFixed(3)}dvh; aspect-ratio: ${ratio.toFixed(3)}; background-image: url('${lqip.src}'); background-size: cover; background-position: center;`}
                    aria-label={`Open ${data.title} in lightbox`}
                >
                    <Image
                        src={data.image}
                    alt={data.alt}
                    data-language-alt
                    data-pt={data.alt}
                    data-en={data.altEn ?? data.alt}
                        widths={[960, 1440, 1920]}
                        sizes="(max-width: 860px) 100vw, (max-width: 1440px) 72vw, 1180px"
                        format="webp"
                        loading="eager"
                        decoding="async"
                    />
                    <span class="post__open" data-language-value data-pt="abrir foto ↗" data-en="open frame ↗">abrir foto ↗</span>
                </a>
            </div>

            <aside class="post__field-note">
                <div class="post__field-number"><span data-language-value data-pt="entrada" data-en="field entry">entrada</span><strong>{indexStr}</strong></div>
                <p class="post__place" data-language-value data-pt={data.country.replace(/-/g, " ")} data-en={(data.countryEn ?? data.country).replace(/-/g, " ")}>{data.country.replace(/-/g, " ")}</p>
                <section class="post__note" aria-label="Nota pessoal">
                    <p class="post__note-label" data-language-value data-pt="nota" data-en="note">nota</p>
                    <div data-language-content="pt"><Content /></div>
                    <p data-language-content="en">{data.noteEn ?? "Translation not available yet."}</p>
                </section>
                <dl>
                    <div><dt data-language-value data-pt="registrado" data-en="recorded">registrado</dt><dd>{monthYear}</dd></div>
                    <div><dt>latitude</dt><dd>{data.latitude == null ? "—" : fmtLat(data.latitude)}</dd></div>
                    <div><dt>longitude</dt><dd>{data.longitude == null ? "—" : fmtLon(data.longitude)}</dd></div>
                    <div><dt>frame</dt><dd>{data.image.width} × {data.image.height}</dd></div>
                    {
                        data.full && fullImageUrl && (
                            <div>
                                <dt data-language-value data-pt="resolução total" data-en="full resolution">resolução total</dt>
                                <dd>
                                    <a class="post__full-link" href={fullImageUrl} target="_blank" rel="noopener">
                                        {data.full.width} × {data.full.height} px ↗
                                    </a>
                                </dd>
                            </div>
                        )
                    }
                </dl>
                {
                    data.latitude != null && data.longitude != null && (
                        <a class="post__map-link" href={mapUrl}>
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                                <circle cx="12" cy="10" r="3" />
                            </svg>
                            <span data-language-value data-pt="ver no atlas" data-en="locate in atlas">ver no atlas</span>
                        </a>
                    )
                }
            </aside>
        </div>

        <nav class="post-nav shell">
            <div class="post-nav__cell">
                {
                    prev && (
                        <a href={urlFor(prev)}>
                            <div class="post-nav__label">← previous entry</div>
                            <div class="post-nav__title">{prev.data.title}</div>
                        </a>
                    )
                }
            </div>
            <div class="post-nav__cell post-nav__cell--next">
                {
                    next && (
                        <a href={urlFor(next)}>
                            <div class="post-nav__label">next entry →</div>
                            <div class="post-nav__title">{next.data.title}</div>
                        </a>
                    )
                }
            </div>
        </nav>
    </main>
</Base>
