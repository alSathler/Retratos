---
import "../styles/global.scss";
import "photoswipe/style.css";
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
    title?: string;
    description?: string;
    showHeader?: boolean;
}

const { title, description, showHeader = true } = Astro.props;
const siteTitle = "diário do explorador.";
const fullTitle = title ? `${title} — ${siteTitle}` : siteTitle;
const desc =
    description ??
    "Um diário visual de lugares, caminhadas e pequenos encontros de um explorador.";
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="pt-BR">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{fullTitle}</title>
        <meta name="description" content={desc} />
        <link rel="canonical" href={canonical} />

        <script is:inline>
            (function () {
                try {
                    var stored = localStorage.getItem("diario-do-explorador:theme");
                    var prefersDark = window.matchMedia(
                        "(prefers-color-scheme: dark)"
                    ).matches;
                    var theme = stored || (prefersDark ? "dark" : "light");
                    document.documentElement.setAttribute("data-theme", theme);
                } catch (e) {
                    document.documentElement.setAttribute("data-theme", "light");
                }
                try {
                    var language = localStorage.getItem("diario-do-explorador:language") || "pt-BR";
                    document.documentElement.setAttribute("data-language", language);
                    document.documentElement.lang = language;
                } catch (e) {
                    document.documentElement.setAttribute("data-language", "pt-BR");
                }
            })();
        </script>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        {showHeader && <SiteHeader />}
        <slot />

        <script>
            import PhotoSwipeLightbox from "photoswipe/lightbox";

            document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((el) => {
                const lightbox = new PhotoSwipeLightbox({
                    gallery: el,
                    children: "a[data-pswp-src]",
                    pswpModule: () => import("photoswipe"),
                    initialZoomLevel: "fit",
                    secondaryZoomLevel: 1.6,
                    maxZoomLevel: 3,
                    wheelToZoom: true,
                    bgOpacity: 0.96,
                });
                lightbox.init();
            });

            const root = document.documentElement;
            const toggle = document.querySelector("[data-theme-toggle]");
            toggle?.addEventListener("click", () => {
                const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
                root.setAttribute("data-theme", next);
                try {
                    localStorage.setItem("diario-do-explorador:theme", next);
                } catch (e) {
                    /* storage unavailable */
                }
            });

            const languageToggle = document.querySelector<HTMLButtonElement>("[data-language-toggle]");
            const setLanguage = (language: "pt-BR" | "en") => {
                root.setAttribute("data-language", language);
                root.lang = language;
                document.querySelectorAll<HTMLElement>("[data-language-value]").forEach((el) => {
                    const value = el.dataset[language === "en" ? "en" : "pt"];
                    if (value) el.textContent = value;
                });
                document.querySelectorAll<HTMLImageElement>("[data-language-alt]").forEach((image) => {
                    image.alt = image.dataset[language === "en" ? "en" : "pt"] || "";
                });
                languageToggle?.setAttribute("aria-pressed", String(language === "en"));
                try {
                    localStorage.setItem("diario-do-explorador:language", language);
                } catch (e) {
                    /* storage unavailable */
                }
            };
            setLanguage(root.getAttribute("data-language") === "en" ? "en" : "pt-BR");
            languageToggle?.addEventListener("click", () => {
                setLanguage(root.getAttribute("data-language") === "en" ? "pt-BR" : "en");
            });
        </script>
    </body>
</html>
