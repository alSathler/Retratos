---
import type { CollectionEntry } from "astro:content";

interface Props {
    panoramas: CollectionEntry<"panoramas">[];
}

const { panoramas } = Astro.props;
const total = panoramas.length;
const countries = new Set(panoramas.map((p) => p.data.country)).size;
const years = panoramas.map((p) => p.data.date.getFullYear());
const firstYear = Math.min(...years);
const lastYear = Math.max(...years);
const span = firstYear === lastYear ? `${firstYear}` : `${firstYear} – ${lastYear}`;
---

<section class="hero">
    <div class="shell hero__folio">
        <aside class="hero__folio-mark" aria-label="Field log volume one">
            <span>field log</span>
            <strong>01</strong>
            <span>{span}</span>
        </aside>

        <div class="hero__folio-copy">
            <p class="hero__eyebrow">a personal record of {total} places</p>
            <h1 class="hero__title">panoramas</h1>
            <p class="hero__lede">
                Travel notes in wide frames — swept slowly by hand on an iPhone X with a DJI Osmo Mobile 3.
            </p>
        </div>

        <dl class="hero__ledger">
            <div><dt>entries</dt><dd>{total}</dd></div>
            <div><dt>countries</dt><dd>{countries}</dd></div>
            <div><dt>recorded</dt><dd>{span}</dd></div>
            <div><dt>camera</dt><dd>iPhone X</dd></div>
            <div><dt>stabilizer</dt><dd>Osmo M3</dd></div>
            <div><dt>method</dt><dd>hand-held sweep</dd></div>
            <p class="hero__ledger-note">one place, one horizon.</p>
        </dl>
    </div>
</section>
