---
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
// Raw country silhouettes injected below with set:html.
import worldLand from "../assets/world-land-geographic.svg?raw";

const VIEW = { minx: 30.767, miny: 241.591, w: 784.077, h: 458.627 };
// Linear map from geographic degrees to the SVG's own plate-carrée geometry.
const PROJ = {
  ax: VIEW.w / 360,
  bx: VIEW.minx + VIEW.w / 2,
  ay: -VIEW.h / 180,
  by: VIEW.miny + VIEW.h / 2,
};
const CX = VIEW.minx + VIEW.w / 2;
const CY = VIEW.miny + VIEW.h / 2;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const entries = (await getCollection("panoramas"))
    .filter((p) => p.data.latitude != null && p.data.longitude != null)
    .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const basePlaces = await Promise.all(
    entries.map(async (p, i) => {
        const d = p.data;
        const lon = d.longitude as number;
        const lat = d.latitude as number;
        const thumb = await getImage({ src: d.image, width: 640, format: "webp" });
        return {
            slug: p.id,
            idx: i + 1,
            title: d.title,
            titleEn: d.titleEn ?? d.title,
            country: d.country.replace(/-/g, " "),
            countryEn: (d.countryEn ?? d.country).replace(/-/g, " "),
            lat,
            lon,
            x: +(PROJ.ax * lon + PROJ.bx).toFixed(2),
            y: +(PROJ.ay * lat + PROJ.by).toFixed(2),
            myPt: d.date.toLocaleDateString("pt-BR", { month: "long", year: "numeric" }),
            myEn: d.date.toLocaleDateString("en-US", { month: "long", year: "numeric" }),
            thumb: thumb.src,
            alt: d.alt,
            altEn: d.altEn ?? d.alt,
            url: `${base}/${p.id}.html`,
        };
    })
);
const NEARBY_THRESHOLD_DEGREES = 0.005;
const places = basePlaces.map((place) => ({
    ...place,
    cluster: basePlaces
        .filter(
            (candidate) =>
                Math.hypot(candidate.lat - place.lat, candidate.lon - place.lon) <=
                NEARBY_THRESHOLD_DEGREES
        )
        .map((candidate) => candidate.slug),
}));
const total = places.length;
const countryAliases: Record<string, string> = {
    "czech-republic": "czech",
};
const countries = new Set(
    entries.map((entry) => countryAliases[entry.data.country] ?? entry.data.country)
).size;
const pad = (n: number) => String(n).padStart(2, "0");
---

<section class="atlas-map" id="map-app">
    <aside class="logbook">
        <div class="logbook__head">
            <div class="logbook__eyebrow" data-language-value data-pt="explorador" data-en="explorer">explorador</div>
            <div class="logbook__count"><span data-language-value data-pt={`${total} lugares, ${countries} países`} data-en={`${total} places, ${countries} countries`}>{total} lugares, {countries} países</span></div>
        </div>
        <div class="logbook__list">
            {
                places.map((p) => (
                    <button class="row" type="button" data-slug={p.slug}>
                        <span class="row__n">{pad(p.idx)}</span>
                        <span>
                            <span class="row__t" data-language-value data-pt={p.title} data-en={p.titleEn}>{p.title}</span>
                            <span class="row__c" data-language-value data-pt={p.country} data-en={p.countryEn}>{p.country}</span>
                        </span>
                    </button>
                ))
            }
        </div>
    </aside>

    <div class="canvas" id="canvas">
        <div class="controls">
            <select class="place-picker" id="place-picker" aria-label="Escolher foto">
                <option value="" data-language-value data-pt="escolha uma foto" data-en="choose a photograph">escolha uma foto</option>
                {places.map((p) => <option value={p.slug} data-language-value data-pt={p.title} data-en={p.titleEn}>{p.title}</option>)}
            </select>
            <button class="ctl" id="world-btn" type="button" hidden>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M15 18l-6-6 6-6"></path></svg>
                <span data-language-value data-pt="mundo" data-en="world">mundo</span>
            </button>
        </div>
        <div class="readout" id="readout" aria-hidden="true"><b>&#8202;&mdash;&#8202;</b></div>

        <svg class="map" viewBox="30.767 241.591 784.077 458.627" preserveAspectRatio="xMidYMid meet" id="svg" role="img" aria-label="World map of panorama locations">
            <g id="world">
                <g class="land" set:html={worldLand}></g>
                <circle id="halo" r="4"></circle>
                <g class="pins">
                    {
                        places.map((p) => (
                            <g
                                class="pin"
                                data-slug={p.slug}
                                tabindex="0"
                                role="button"
                                aria-label={`Fly to ${p.title}${p.cluster.length > 1 ? `, ${p.cluster.length} nearby panoramas` : ""}`}
                            >
                                <circle class="hit" cx={p.x} cy={p.y} r="9" />
                                <circle class="ring" cx={p.x} cy={p.y} r="6" />
                                <circle class="dot" cx={p.x} cy={p.y} r="3.4" />
                                {
                                    p.cluster.length > 1 && (
                                        <text class="pin__count" x={p.x} y={p.y} font-size="8" dx="6" dy="-5">
                                            {p.cluster.length}
                                        </text>
                                    )
                                }
                            </g>
                        ))
                    }
                </g>
                <g class="labels">
                    {
                        places.map((p) => (
                            <text class="lbl" data-slug={p.slug} data-language-value data-pt={p.title} data-en={p.titleEn} x={p.x} y={p.y} font-size="11" dx="8" dy="4" stroke-width="3">
                                {p.title}
                            </text>
                        ))
                    }
                </g>
            </g>
        </svg>

        <article class="card" id="card" aria-live="polite">
            <a class="card__frame" id="c-image-link" href="#" aria-label="Abrir fotografia">
                <img id="c-img" alt="" decoding="async" />
            </a>
            <div class="card__kicker"><span id="c-country">&mdash;</span><span class="card__idx" id="c-idx">{`00 / ${total}`}</span></div>
            <h2 class="card__title" id="c-title">&mdash;</h2>
            <div class="card__coords"><span class="deg" id="c-lat">&mdash;</span><span id="c-lon">&mdash;</span></div>
            <div class="card__foot">
                <span class="card__date" id="c-date">&mdash;</span>
                <a class="card__view" id="c-view" href="#"><span data-language-value data-pt="abrir foto" data-en="view frame">abrir foto</span>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                </a>
            </div>
        </article>

        <p class="hint" data-language-value data-pt="toque num ponto ou entrada para aproximar · esc para afastar" data-en="click a pin or a logbook entry to fly in · esc to zoom out">toque num ponto ou entrada para aproximar · esc para afastar</p>
    </div>
</section>

<style>
    .atlas-map {
        /* fills the viewport below the 65px sticky site header */
        --land: color-mix(in srgb, var(--ink) 10%, transparent);
        --land-edge: color-mix(in srgb, var(--ink) 18%, transparent);
        --card-bg: color-mix(in srgb, var(--bg-elev) 76%, transparent);
        height: calc(100dvh - 65px);
        display: grid;
        grid-template-columns: 280px 1fr;
        overflow: hidden;
    }
    @media (max-width: 820px) {
        .atlas-map {
            grid-template-columns: 1fr;
        }
    }

    /* logbook rail */
    .logbook {
        border-right: 1px solid var(--rule);
        min-height: 0;
        display: flex;
        flex-direction: column;
        background: var(--bg);
    }
    @media (max-width: 820px) {
        .logbook {
            display: none;
        }
    }
    .logbook__head {
        padding: 18px 22px 12px;
        border-bottom: 1px solid var(--rule);
    }
    .logbook__eyebrow {
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--ink-muted);
    }
    .logbook__count {
        font-family: var(--font-display);
        font-style: italic;
        font-size: 19px;
        margin-top: 3px;
        color: var(--ink);
    }
    .logbook__list {
        overflow-y: auto;
        flex: 1;
        min-height: 0;
        padding: 6px 0;
    }
    .row {
        display: grid;
        grid-template-columns: 34px 1fr;
        gap: 10px;
        align-items: baseline;
        width: 100%;
        text-align: left;
        padding: 10px 22px;
        cursor: pointer;
        border: 0;
        background: none;
        border-left: 2px solid transparent;
        transition: background 180ms ease, border-color 180ms ease;
    }
    .row:hover {
        background: color-mix(in srgb, var(--ink) 4%, transparent);
    }
    .row.active {
        border-left-color: var(--accent);
        background: color-mix(in srgb, var(--accent) 8%, transparent);
    }
    .row__n {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--ink-muted);
        font-variant-numeric: tabular-nums;
    }
    .row.active .row__n {
        color: var(--accent);
    }
    .row__t {
        display: block;
        font-size: 13.5px;
        line-height: 1.3;
        color: var(--ink-soft);
    }
    .row__c {
        display: block;
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-muted);
        margin-top: 4px;
    }

    /* canvas */
    .canvas {
        position: relative;
        min-height: 0;
        overflow: hidden;
    }
    .map {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
        touch-action: none;
    }
    #world {
        transition: transform 950ms cubic-bezier(0.16, 1, 0.3, 1);
        will-change: transform;
    }
    #world.dragging {
        transition: none;
    }
    /* land paths are injected via set:html, so they need a :global reach */
    :global(.atlas-map .land path) {
        fill: var(--land);
        stroke: var(--land-edge);
        stroke-width: 0.35;
        vector-effect: non-scaling-stroke;
    }
    .pin {
        cursor: pointer;
        transform-box: fill-box;
        transform-origin: center;
        transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
        outline: none;
    }
    .pin .hit {
        fill: transparent;
    }
    .pin .ring {
        fill: none;
        stroke: var(--accent);
        opacity: 0.5;
        vector-effect: non-scaling-stroke;
    }
    .pin .dot {
        fill: var(--accent);
    }
    .pin__count {
        fill: var(--ink);
        font-family: var(--font-mono);
        font-weight: 600;
        paint-order: stroke;
        stroke: var(--bg);
        stroke-width: 2px;
        pointer-events: none;
    }
    .pin:hover,
    .pin.active,
    .pin:focus-visible {
        transform: scale(1.55);
    }
    .pin:focus-visible .ring {
        opacity: 1;
        stroke-width: 2;
    }
    .pin.active .dot {
        fill: var(--accent-hover);
    }
    .pin.dim {
        opacity: 0.32;
        transition: opacity 500ms ease;
    }
    .lbl {
        font-family: var(--font-mono);
        fill: var(--ink);
        paint-order: stroke;
        stroke: var(--bg);
        opacity: 0;
        transition: opacity 300ms ease;
        pointer-events: none;
        letter-spacing: 0.02em;
    }
    .lbl.show {
        opacity: 1;
    }
    #halo {
        fill: none;
        stroke: var(--accent);
        opacity: 0;
        transform-box: fill-box;
        transform-origin: center;
    }
    #halo.go {
        animation: halo-pulse 1800ms ease-out infinite;
    }
    @keyframes halo-pulse {
        0% {
            transform: scale(1);
            opacity: 0.55;
        }
        70% {
            opacity: 0;
        }
        100% {
            transform: scale(4);
            opacity: 0;
        }
    }

    /* overlays */
    .controls {
        position: absolute;
        top: 16px;
        left: 16px;
        z-index: 3;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .place-picker {
        display: none;
        min-width: 0;
        max-width: min(68vw, 310px);
        color: var(--ink);
        background: var(--card-bg);
        border: 1px solid var(--rule);
        border-radius: 999px;
        padding: 8px 32px 8px 13px;
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.04em;
        backdrop-filter: blur(10px);
    }
    @media (max-width: 820px) {
        .place-picker {
            display: block;
        }
    }
    .ctl {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-soft);
        padding: 8px 13px;
        border: 1px solid var(--rule);
        border-radius: 999px;
        cursor: pointer;
        background: var(--card-bg);
        backdrop-filter: blur(10px);
        box-shadow: inset 0 1px 0 color-mix(in srgb, #fff 12%, transparent);
        transition: color 200ms ease, border-color 200ms ease, transform 100ms ease;
        display: inline-flex;
        align-items: center;
        gap: 7px;
    }
    .ctl:hover {
        color: var(--ink);
        border-color: var(--rule-strong);
    }
    .ctl:active {
        transform: translateY(1px);
    }
    .ctl[hidden] {
        display: none;
    }
    .readout {
        position: absolute;
        top: 16px;
        right: 16px;
        z-index: 3;
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.06em;
        color: var(--ink-muted);
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
        padding: 8px 12px;
        border: 1px solid var(--rule);
        border-radius: 999px;
        background: var(--card-bg);
        backdrop-filter: blur(10px);
    }
    .readout b {
        color: var(--ink-soft);
        font-weight: 500;
    }
    @media (max-width: 560px) {
        .readout {
            display: none;
        }
    }

    /* placard card */
    .card {
        position: absolute;
        left: 16px;
        bottom: 16px;
        width: min(340px, calc(100% - 32px));
        z-index: 4;
        background: var(--card-bg);
        backdrop-filter: blur(16px) saturate(140%);
        border: 1px solid var(--rule);
        border-radius: 16px;
        padding: 16px 18px 18px;
        box-shadow: 0 24px 48px -18px rgba(0, 0, 0, 0.28),
            inset 0 1px 0 color-mix(in srgb, #fff 14%, transparent);
        opacity: 0;
        transform: translateY(14px);
        pointer-events: none;
        transition: opacity 500ms ease, transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .card.show {
        opacity: 1;
        transform: none;
        pointer-events: auto;
    }
    .card__frame {
        display: block;
        width: auto;
        height: clamp(82px, calc(100dvh - 320px), 150px);
        aspect-ratio: 3 / 4;
        margin-inline: auto;
        border-radius: 9px;
        overflow: hidden;
        margin-bottom: 14px;
        border: 0;
        background: color-mix(in srgb, var(--ink) 6%, transparent);
        transition: box-shadow 180ms ease, transform 180ms ease;
    }
    .card__frame:hover,
    .card__frame:focus-visible {
        box-shadow: 0 0 0 1px var(--accent);
        transform: translateY(-2px);
    }
    .card__frame img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
    .card__kicker {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--ink-muted);
    }
    .card__idx {
        color: var(--accent);
    }
    .card__title {
        font-family: var(--font-display);
        font-style: italic;
        font-weight: 400;
        font-size: 27px;
        line-height: 1.08;
        margin: 7px 0 12px;
        letter-spacing: -0.01em;
        text-wrap: balance;
        color: var(--ink);
    }
    .card__coords {
        font-family: var(--font-mono);
        font-size: 12.5px;
        color: var(--ink-soft);
        letter-spacing: 0.03em;
        font-variant-numeric: tabular-nums;
        display: flex;
        gap: 8px;
        align-items: center;
    }
    .card__coords .deg {
        color: var(--accent);
    }
    .card__foot {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 14px;
        padding-top: 12px;
        border-top: 1px solid var(--rule);
    }
    .card__date {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--ink-muted);
        letter-spacing: 0.04em;
    }
    .card__view {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink);
        display: inline-flex;
        gap: 6px;
        align-items: center;
        transition: gap 200ms ease, color 200ms ease;
    }
    .card__view:hover {
        color: var(--accent);
        gap: 10px;
    }

    .hint {
        position: absolute;
        right: 16px;
        bottom: 16px;
        margin: 0;
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.08em;
        color: var(--ink-muted);
        text-align: right;
        z-index: 2;
        opacity: 0.8;
        pointer-events: none;
    }
    @media (max-width: 560px) {
        .hint {
            display: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        #world {
            transition: none;
        }
        #halo.go {
            animation: none;
        }
    }
</style>

<script is:inline define:vars={{ places, PROJ, CX, CY, FOCUS_K: 7, BASE_R: 3.4, total }}>
    (function () {
        const root = document.getElementById("map-app");
        if (!root) return;
        const q = (id) => root.querySelector("#" + id);
        const svg = q("svg");
        const world = q("world");
        const halo = q("halo");
        const readout = q("readout");
        const worldBtn = q("world-btn");
        const placePicker = q("place-picker");
        const card = q("card");
        const canvas = q("canvas");

        const place = {};
        const pinEl = {};
        const lblEl = {};
        const rowEl = {};
        places.forEach((p) => {
            place[p.slug] = p;
            pinEl[p.slug] = root.querySelector('.pin[data-slug="' + p.slug + '"]');
            lblEl[p.slug] = root.querySelector('.lbl[data-slug="' + p.slug + '"]');
            rowEl[p.slug] = root.querySelector('.row[data-slug="' + p.slug + '"]');
        });
        let active = null;
        let viewX = CX;
        let viewY = CY;
        let zoom = 1;
        const MIN_ZOOM = 1;
        const MAX_ZOOM = 20;
        const pointers = new Map();
        let gesture = null;
        let ignoreClick = false;

        const fmtLat = (v) => Math.abs(v).toFixed(4) + "° " + (v >= 0 ? "N" : "S");
        const fmtLon = (v) => Math.abs(v).toFixed(4) + "° " + (v >= 0 ? "E" : "W");

        function sizePins(k) {
            const s = 1 / k;
            for (const slug in pinEl) {
                const g = pinEl[slug];
                g.querySelector(".dot").setAttribute("r", (BASE_R * s).toFixed(3));
                g.querySelector(".ring").setAttribute("r", (6 * s).toFixed(3));
                g.querySelector(".hit").setAttribute("r", (9 * s).toFixed(3));
                const count = g.querySelector(".pin__count");
                if (count) {
                    count.setAttribute("font-size", (8 * s).toFixed(3));
                    count.setAttribute("dx", (6 * s).toFixed(3));
                    count.setAttribute("dy", (-5 * s).toFixed(3));
                    count.setAttribute("stroke-width", (2 * s).toFixed(3));
                }
            }
            for (const slug in lblEl) {
                const t = lblEl[slug];
                t.setAttribute("font-size", (11 * s).toFixed(3));
                t.setAttribute("dx", (8 * s).toFixed(3));
                t.setAttribute("dy", (4 * s).toFixed(3));
                t.setAttribute("stroke-width", (3 * s).toFixed(3));
            }
            halo.setAttribute("r", (BASE_R * s).toFixed(3));
        }

        function setTransform(px, py, k) {
            viewX = px;
            viewY = py;
            zoom = Math.max(MIN_ZOOM, Math.min(MAX_ZOOM, k));
            world.setAttribute(
                "transform",
                "translate(" + CX + " " + CY + ") scale(" + zoom + ") translate(" + -viewX + " " + -viewY + ")"
            );
            sizePins(zoom);
        }

        function mapPoint(clientX, clientY) {
            const matrix = svg.getScreenCTM();
            if (!matrix) return null;
            const point = svg.createSVGPoint();
            point.x = clientX;
            point.y = clientY;
            return point.matrixTransform(matrix.inverse());
        }

        function zoomAt(point, factor) {
            const nextZoom = Math.max(MIN_ZOOM, Math.min(MAX_ZOOM, zoom * factor));
            if (nextZoom === zoom) return;
            const sourceX = viewX + (point.x - CX) / zoom;
            const sourceY = viewY + (point.y - CY) / zoom;
            setTransform(
                sourceX - (point.x - CX) / nextZoom,
                sourceY - (point.y - CY) / nextZoom,
                nextZoom
            );
        }

        function hover(slug, on) {
            if (active) return;
            pinEl[slug].classList.toggle("active", on);
            rowEl[slug].classList.toggle("active", on);
            lblEl[slug].classList.toggle("show", on);
        }

        function focusPlace(slug) {
            const p = place[slug];
            const english = document.documentElement.getAttribute("data-language") === "en";
            active = slug;
            for (const s in pinEl) {
                pinEl[s].classList.toggle("active", s === slug);
                pinEl[s].classList.toggle("dim", s !== slug);
                rowEl[s].classList.toggle("active", s === slug);
                lblEl[s].classList.toggle("show", s === slug);
            }
            halo.setAttribute("cx", p.x);
            halo.setAttribute("cy", p.y);
            halo.classList.add("go");
            setTransform(p.x, p.y, FOCUS_K);

            const img = q("c-img");
            img.src = p.thumb;
            img.alt = english ? p.altEn : p.alt;
            q("c-country").textContent = english ? p.countryEn : p.country;
            q("c-idx").textContent = String(p.idx).padStart(2, "0") + " / " + total;
            q("c-title").textContent = english ? p.titleEn : p.title;
            q("c-lat").textContent = fmtLat(p.lat);
            q("c-lon").textContent = fmtLon(p.lon);
            q("c-date").textContent = english ? p.myEn : p.myPt;
            q("c-view").setAttribute("href", p.url);
            q("c-image-link").setAttribute("href", p.url);
            placePicker.value = slug;
            card.classList.add("show");
            worldBtn.hidden = false;
            const r = rowEl[slug];
            if (r.scrollIntoView) r.scrollIntoView({ block: "nearest" });
            try {
                history.replaceState(null, "", "#" + slug);
            } catch (e) {
                /* history unavailable */
            }
        }

        window.addEventListener("diario-language-change", () => {
            if (active) focusPlace(active);
        });

        function focusPin(slug) {
            const cluster = place[slug].cluster;
            const activeIndex = cluster.indexOf(active);
            const nextIndex = activeIndex >= 0 ? (activeIndex + 1) % cluster.length : 0;
            focusPlace(cluster[nextIndex]);
        }

        function reset() {
            active = null;
            for (const s in pinEl) {
                pinEl[s].classList.remove("active", "dim");
                rowEl[s].classList.remove("active");
                lblEl[s].classList.remove("show");
            }
            halo.classList.remove("go");
            setTransform(CX, CY, 1);
            card.classList.remove("show");
            placePicker.value = "";
            worldBtn.hidden = true;
            try {
                history.replaceState(null, "", location.pathname + location.search);
            } catch (e) {
                /* history unavailable */
            }
        }

        for (const slug in pinEl) {
            const g = pinEl[slug];
            g.addEventListener("click", (e) => {
                e.stopPropagation();
                focusPin(slug);
            });
            g.addEventListener("keydown", (e) => {
                if (e.key === "Enter" || e.key === " ") {
                    e.preventDefault();
                    focusPlace(slug);
                }
            });
            g.addEventListener("mouseenter", () => hover(slug, true));
            g.addEventListener("mouseleave", () => hover(slug, false));
        }
        for (const slug in rowEl) {
            const r = rowEl[slug];
            r.addEventListener("click", () => focusPlace(slug));
            r.addEventListener("mouseenter", () => hover(slug, true));
            r.addEventListener("mouseleave", () => hover(slug, false));
        }

        canvas.addEventListener("pointermove", (e) => {
            const m = world.getScreenCTM();
            if (!m) return;
            const pt = svg.createSVGPoint();
            pt.x = e.clientX;
            pt.y = e.clientY;
            const loc = pt.matrixTransform(m.inverse());
            const lon = (loc.x - PROJ.bx) / PROJ.ax;
            const lat = (loc.y - PROJ.by) / PROJ.ay;
            readout.innerHTML = "<b>" + fmtLat(lat) + "</b> <b>" + fmtLon(lon) + "</b>";
        });
        canvas.addEventListener("pointerleave", () => {
            readout.innerHTML = "<b> — </b>";
        });
        svg.addEventListener("wheel", (e) => {
            const point = mapPoint(e.clientX, e.clientY);
            if (!point) return;
            e.preventDefault();
            zoomAt(point, Math.exp(-e.deltaY * 0.002));
        }, { passive: false });

        svg.addEventListener("pointerdown", (e) => {
            if (!mapPoint(e.clientX, e.clientY)) return;
            pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
            try { svg.setPointerCapture(e.pointerId); } catch (_) { /* unsupported */ }
            world.classList.add("dragging");
            gesture = { startX: e.clientX, startY: e.clientY, viewX, viewY, moved: false, distance: null };
        });
        svg.addEventListener("pointermove", (e) => {
            if (!pointers.has(e.pointerId) || !gesture) return;
            pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
            const points = Array.from(pointers.values());
            if (points.length >= 2) {
                const a = points[0];
                const b = points[1];
                const point = mapPoint((a.x + b.x) / 2, (a.y + b.y) / 2);
                const distance = Math.hypot(a.x - b.x, a.y - b.y);
                if (point && gesture.distance) zoomAt(point, distance / gesture.distance);
                gesture.distance = distance;
                gesture.moved = true;
                return;
            }
            const dx = e.clientX - gesture.startX;
            const dy = e.clientY - gesture.startY;
            if (Math.hypot(dx, dy) > 3) gesture.moved = true;
            if (gesture.moved) setTransform(gesture.viewX - dx / zoom, gesture.viewY - dy / zoom, zoom);
        });
        function endGesture(e) {
            if (!pointers.has(e.pointerId)) return;
            if (gesture && gesture.moved) {
                ignoreClick = true;
                setTimeout(() => { ignoreClick = false; }, 0);
            }
            pointers.delete(e.pointerId);
            if (pointers.size < 2 && pointers.size) {
                const remaining = Array.from(pointers.values())[0];
                gesture = { startX: remaining.x, startY: remaining.y, viewX, viewY, moved: true, distance: null };
            } else if (!pointers.size) {
                gesture = null;
                world.classList.remove("dragging");
            }
        }
        svg.addEventListener("pointerup", endGesture);
        svg.addEventListener("pointercancel", endGesture);
        svg.addEventListener("click", (e) => {
            if (ignoreClick) return;
            if (e.target === svg || e.target.tagName === "path") reset();
        });
        worldBtn.addEventListener("click", reset);
        placePicker.addEventListener("change", () => {
            if (placePicker.value) focusPlace(placePicker.value);
            else reset();
        });
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") reset();
        });

        setTransform(CX, CY, 1);

        // Deep-link: /map#<slug> flies straight to that frame (e.g. from a
        // panorama's detail page). Animates in from the world view for effect.
        function focusFromHash() {
            const slug = decodeURIComponent((location.hash || "").replace(/^#/, ""));
            if (slug && place[slug]) {
                setTimeout(() => focusPlace(slug), 350);
            }
        }
        focusFromHash();
        window.addEventListener("hashchange", () => {
            const slug = decodeURIComponent((location.hash || "").replace(/^#/, ""));
            if (slug && place[slug]) focusPlace(slug);
            else if (!slug) reset();
        });
    })();
</script>
