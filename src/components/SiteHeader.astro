---
import { getCollection } from "astro:content";
import ThemeToggle from "./ThemeToggle.astro";

const panoramas = await getCollection("panoramas");
const count = panoramas.length;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const home = `${base}/` || "/";
const mapUrl = `${base}/map`;
const pathname = Astro.url.pathname.replace(/\/$/, "");
const onMap = pathname === mapUrl || pathname === `${mapUrl}.html`;
---

<header class="site-header">
    <div class="shell site-header__inner">
        <a class="site-brand" href={home} rel="author">
            panoramas<sup>{count} places</sup>
        </a>
        <nav class="site-nav">
            <a href={mapUrl} aria-current={onMap ? "page" : undefined}>atlas</a>
            <a href="https://github.com/4gray/panoramas" rel="me">github</a>
            <ThemeToggle />
        </nav>
    </div>
</header>
