---
import { Image, getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
    panorama: CollectionEntry<"panoramas">;
    index: number;
    total: number;
}

const { panorama, index, total } = Astro.props;
const { data, id } = panorama;
const ratio = data.image.width / data.image.height;
const indexStr = String(index).padStart(2, "0");
const totalStr = String(total).padStart(2, "0");

const monthYear = data.date.toLocaleDateString("en-US", {
    month: "long",
    year: "numeric",
});
const fmtLat = (value: number) =>
    `${Math.abs(value).toFixed(4)}° ${value >= 0 ? "N" : "S"}`;
const fmtLon = (value: number) =>
    `${Math.abs(value).toFixed(4)}° ${value >= 0 ? "E" : "W"}`;

const postUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${id}.html`;

const fullImage = await getImage({
    src: data.image,
    width: Math.min(data.image.width, 2400),
    format: "webp",
});

const lqip = await getImage({
    src: data.image,
    width: 24,
    format: "jpg",
    quality: 30,
});
---

<article class="log-entry" id={id}>
    <aside class="log-entry__margin" aria-label={`Entry ${index} of ${total}`}>
        <span>no.</span>
        <strong>{indexStr}</strong>
        <span>/ {totalStr}</span>
        <time datetime={data.date.toISOString()}>{monthYear}</time>
    </aside>

    <div class="log-entry__sheet">
        <header class="log-entry__head">
            <div>
                <p>{data.country.replace(/-/g, " ")}</p>
                <h2><a href={postUrl}>{data.title}</a></h2>
            </div>
            <dl>
                <div><dt>latitude</dt><dd>{data.latitude == null ? "—" : fmtLat(data.latitude)}</dd></div>
                <div><dt>longitude</dt><dd>{data.longitude == null ? "—" : fmtLon(data.longitude)}</dd></div>
            </dl>
        </header>

        <a
            class="log-entry__frame"
            href={fullImage.src}
            data-pswp-width={fullImage.attributes.width ?? data.image.width}
            data-pswp-height={fullImage.attributes.height ?? data.image.height}
            data-pswp-src={fullImage.src}
            data-permalink={postUrl}
            style={`aspect-ratio: ${ratio.toFixed(3)}; background-image: url('${lqip.src}'); background-size: cover; background-position: center;`}
            aria-label={`Open ${data.title} in lightbox`}
        >
            <Image
                class="log-entry__img"
                src={data.image}
                alt={data.alt}
                widths={[480, 960, 1440]}
                sizes="(max-width: 720px) 100vw, (max-width: 1180px) 80vw, 980px"
                format="webp"
                loading={index <= 2 ? "eager" : "lazy"}
                decoding="async"
            />
        </a>

        <footer class="log-entry__foot">
            <span>{data.image.width} × {data.image.height} px</span>
            <span>field note · slow sweep</span>
            <a href={postUrl}>open field entry →</a>
        </footer>
    </div>
</article>
